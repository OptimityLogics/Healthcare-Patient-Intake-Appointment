    {
      "parameters": {
        "chatId": "YOUR_STAFF_TELEGRAM_CHAT_ID",
        "text": "=URGENT - HUMAN REVIEW NEEDED\nPatient: {{ $json.firstName }}\nTelegram chat ID: {{ $json.chatId }}\nMessage: {{ $json.text }}\nTime: {{ $now.toFormat(\"dd LLL yyyy, HH:mm\") }}\nAction: contact this patient immediately. No appointment was booked by the AI.",
